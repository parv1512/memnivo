# Node 24+. All credentials are server-side. Never commit .env.local.
MEMNIVO_DATA_DIR=.data
MEMNIVO_APP_NAME=Memnivo
# Provider: openai-compatible | ollama | none
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
# Local Ollama: AI_PROVIDER=ollama, AI_BASE_URL=http://127.0.0.1:11434/v1
# Enable AI data sharing separately in Settings. Sensitive items are excluded.
# Vault paths are configured only from this local CLI, never through HTTP:
# npm run vault -- connect "C:\path\to\vault" --include Notes,Projects --exclude Private
